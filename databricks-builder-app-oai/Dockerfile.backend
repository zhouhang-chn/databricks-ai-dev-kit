FROM python:3.12-slim AS builder

ARG DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
ARG DEBIAN_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security

RUN set -eux; \
  if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
    sed -i \
      -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
      /etc/apt/sources.list.d/debian.sources; \
  fi; \
  if [ -f /etc/apt/sources.list ]; then \
    sed -i \
      -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
      /etc/apt/sources.list; \
  fi; \
  apt-get -o Acquire::Retries=5 update; \
  apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    ca-certificates \
    gcc \
    g++ \
    git \
    python3-dev \
    ninja-build \
    libc6-dev \
    pkg-config; \
  rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY databricks-tools-core ./databricks-tools-core
COPY databricks-mcp-server ./databricks-mcp-server
COPY databricks-builder-app-oai ./databricks-builder-app-oai

WORKDIR /app/databricks-builder-app-oai

RUN python -m pip install --no-cache-dir --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple \
  && pip wheel --no-cache-dir --wheel-dir /wheels \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    ../databricks-tools-core \
    ../databricks-mcp-server \
    .

FROM python:3.12-slim

ARG DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
ARG DEBIAN_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV ENV=development
ENV BACKEND_PORT=8000
ENV PROJECTS_BASE_DIR=/app/databricks-builder-app-oai/projects

RUN set -eux; \
  if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
    sed -i \
      -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
      /etc/apt/sources.list.d/debian.sources; \
  fi; \
  if [ -f /etc/apt/sources.list ]; then \
    sed -i \
      -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
      /etc/apt/sources.list; \
  fi; \
  apt-get -o Acquire::Retries=5 update; \
  apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    ca-certificates \
    curl \
    dnsutils; \
  rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /wheels /wheels
RUN python -m pip install --no-cache-dir --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple \
  && pip install --no-cache-dir --no-index --find-links=/wheels \
    databricks-tools-core \
    databricks-mcp-server \
    databricks-builder-app-oai \
  && python -c "import databricks_tools_core, databricks_mcp_server" \
  && rm -rf /wheels

COPY databricks-skills ./databricks-skills
COPY databricks-builder-app-oai ./databricks-builder-app-oai

WORKDIR /app/databricks-builder-app-oai

RUN mkdir -p projects logs skills

EXPOSE 8000

CMD ["sh", "-c", "uvicorn server.app:app --host 0.0.0.0 --port ${BACKEND_PORT:-${PORT:-8000}}"]
